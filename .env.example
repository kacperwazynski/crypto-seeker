# CryptoCompare API key (get a free one at https://www.cryptocompare.com/)
CRYPTOCOMPARE_API_KEY=your_api_key_here

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/crypto_seeker

# Optional: Flask secret key (generate a random string for production)
SECRET_KEY=change-me-to-a-random-secret
